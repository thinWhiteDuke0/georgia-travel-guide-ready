# Copy to .env and change the secret before any real deployment.
# The same secret must be shared by the auth service (token signing)
# and the gateway (token verification).
#
# IMPORTANT: HS256 requires at least 32 characters (256 bits).
# A shorter value makes token signing fail with error IDX10720.
JWT_SECRET=dev-only-insecure-secret-change-me-32bytes-min
